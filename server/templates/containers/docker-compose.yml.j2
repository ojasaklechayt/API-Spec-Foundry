services:
  app:
    build: .
    env_file:
      - .env
    ports:
      - "8000:8000"
{% if include_db %}
    depends_on:
      - db

  db:
    image: postgres:16
    environment:
      POSTGRES_DB: {{ project_slug | replace('-', '_') }}
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
{% endif %}
