from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    cors_origins: list[str] = ["http://localhost:5173"]
    cors_allow_credentials: bool = True
    debug: bool = False
{% if ir.db_backend == "postgres" %}
    database_url: str = "postgresql+asyncpg://postgres:postgres@localhost:5432/{{ ir.project_slug | replace('-', '_') }}"
{% else %}
    database_url: str = "sqlite+aiosqlite:///./{{ ir.project_slug }}.db"
{% endif %}

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=False,
        extra="ignore",
    )


settings = Settings()
