from __future__ import annotations

PAYLOAD = {{ resource.sample_payload_literal }}
UPDATE_PAYLOAD = {{ resource.update_payload_literal }}


def test_create_{{ resource.module_name }}(client) -> None:
    response = client.post("{{ resource.collection_path }}", json=PAYLOAD)
    assert response.status_code == 201
    body = response.json()
    assert body["id"] >= 1


def test_list_{{ resource.module_name }}(client) -> None:
    created = client.post("{{ resource.collection_path }}", json=PAYLOAD)
    response = client.get("{{ resource.collection_path }}")
    assert response.status_code == 200
    assert any(item["id"] == created.json()["id"] for item in response.json())


def test_get_{{ resource.module_name }}(client) -> None:
    created = client.post("{{ resource.collection_path }}", json=PAYLOAD)
    item_id = created.json()["id"]
    response = client.get("{{ resource.detail_path }}".format(item_id=item_id))
    assert response.status_code == 200
    assert response.json()["id"] == item_id


def test_update_{{ resource.module_name }}(client) -> None:
    created = client.post("{{ resource.collection_path }}", json=PAYLOAD)
    item_id = created.json()["id"]
    response = client.put("{{ resource.detail_path }}".format(item_id=item_id), json=UPDATE_PAYLOAD)
    assert response.status_code == 200
    for key, value in UPDATE_PAYLOAD.items():
        assert response.json()[key] == value


def test_delete_{{ resource.module_name }}(client) -> None:
    created = client.post("{{ resource.collection_path }}", json=PAYLOAD)
    item_id = created.json()["id"]
    response = client.delete("{{ resource.detail_path }}".format(item_id=item_id))
    assert response.status_code == 204
    missing = client.get("{{ resource.detail_path }}".format(item_id=item_id))
    assert missing.status_code == 404
